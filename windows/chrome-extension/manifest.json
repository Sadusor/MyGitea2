{
  "manifest_version": 3,
  "name": "MyGitea2 Local Controls",
  "version": "1.0.0",
  "description": "Local-only toolbar for MyGitea2 Chrome app.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:3002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3001/*"
      ],
      "js": [
        "toolbar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
